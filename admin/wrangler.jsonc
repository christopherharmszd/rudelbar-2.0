{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rudelbar-cms-staging",
  "account_id": "87e06345951a028223b167dd69056336",
  "main": "./cloudflare-entry.mjs",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "version_metadata": {"binding":"CF_VERSION_METADATA"},
  "triggers": {"crons":["* * * * *"]},
  "build": { "command": "node ../event-app/prepare.mjs" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SANITY_PROJECT_ID": "uywmld5e",
    "SANITY_DATASET": "staging",
    "SANITY_WEBSITE_DATASET": "production",
    "RUDELBAR_CONNECTED_IDENTITY": "1",
    "RUDELBAR_RUNTIME_RELEASES": "1",
    "RUDELBAR_CONNECTED_SOCIAL": "1",
    "VISITOR_APP_URL": "https://rudelbar-app-staging.christopher-harms.workers.dev"
  },
  "d1_databases": [{"binding":"LIVE_DB","database_name":"rudelbar-live-staging","database_id":"5207ce12-4fc5-4923-a92b-d30a8699b0ff","migrations_dir":"migrations"}],
  "ratelimits": [{
    "name": "LOGIN_LIMITER",
    "namespace_id": "7321821",
    "simple": { "limit": 8, "period": 60 }
  }]
}
