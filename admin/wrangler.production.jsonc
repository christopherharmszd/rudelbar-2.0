{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rudelbar-cms",
  "account_id": "87e06345951a028223b167dd69056336",
  "main": "./worker.mjs",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SANITY_PROJECT_ID": "uywmld5e",
    "SANITY_DATASET": "production"
  },
  "ratelimits": [{
    "name": "LOGIN_LIMITER",
    "namespace_id": "7321822",
    "simple": { "limit": 8, "period": 60 }
  }]
}
